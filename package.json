{
  "name": "@synclicht/client",
  "version": "0.0.3",
  "description": "A TypeScript client for SyncLicht, providing real-time projection updates via WebSocket with local storage capabilities",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:cleanup",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cleanup": "rimraf \"dist/__tests__\" \"dist/types/__tests__\" \"dist/esm/__tests__\"",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run test && npm run build",
    "link-local": "npm run build && npm link && echo 'Package linked globally. Run npm link @synclicht/client in your project to use it.'"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "keywords": [
    "synclicht",
    "websocket",
    "projection",
    "realtime",
    "typescript"
  ],
  "author": "sajithmohan.vk@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synclicht-com/client.git"
  },
  "bugs": {
    "url": "https://github.com/synclicht-com/client/issues"
  },
  "homepage": "https://github.com/synclicht-com/client#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "localforage": "^1.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
