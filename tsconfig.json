{
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "declaration": true,
      "declarationDir": "./dist/types",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [
      "node_modules",
      "dist",
      "src/**/__tests__/**",
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ]
  }
  